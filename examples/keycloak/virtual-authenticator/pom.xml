<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.pqkc</groupId>
  <artifactId>virtual-mldsa-authenticator</artifactId>
  <version>1.0.0</version>
  <licenses><license>
    <name>Apache License, Version 2.0</name>
    <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    <distribution>repo</distribution>
  </license></licenses>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.82</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-cbor</artifactId><version>2.19.2</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.19.2</version></dependency>
  </dependencies>
  <build>
    <finalName>virtual-mldsa-authenticator</finalName>
    <plugins>
      <!-- Keep each dependency's notices under its own path: a fat JAR can otherwise
           overwrite identically named META-INF/LICENSE and META-INF/NOTICE files. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
        <executions><execution>
          <id>preserve-dependency-notices</id><phase>generate-resources</phase>
          <goals><goal>unpack-dependencies</goal></goals>
          <configuration>
            <includeScope>runtime</includeScope>
            <includes>META-INF/*LICENSE*,META-INF/*NOTICE*,META-INF/*license*,META-INF/*notice*,LICENSE*,NOTICE*</includes>
            <outputDirectory>${project.build.outputDirectory}/META-INF/dependency-notices</outputDirectory>
            <useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
          </configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId><version>3.7.1</version>
        <configuration>
          <descriptorRefs><descriptorRef>jar-with-dependencies</descriptorRef></descriptorRefs>
          <archive><manifest><mainClass>org.pqkc.webauthn.va.Ceremony</mainClass></manifest></archive>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions><execution><id>make</id><phase>package</phase><goals><goal>single</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
